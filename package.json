{
  "name": "vicuna-store",
  "private": true,
  "type": "module",
  "description": "Vicuna belts store — React SSR + TypeScript + Tailwind v4 + GSAP + Lenis, static on GitHub Pages (docs/).",
  "scripts": {
    "build": "tsx scripts/build.tsx",
    "dev": "tsx scripts/build.tsx && npx --yes serve docs",
    "typecheck": "tsc --noEmit",
    "nx": "nx",
    "graph": "nx graph",
    "typecheck:all": "nx run-many -t typecheck"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "nx": "^23.2.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
