{
  "name": "vicuna-store",
  "private": true,
  "type": "module",
  "description": "Vicuna belts store — static site built with React (server-rendered) + TypeScript, deployed on GitHub Pages from docs/.",
  "scripts": {
    "build": "tsx scripts/build.tsx",
